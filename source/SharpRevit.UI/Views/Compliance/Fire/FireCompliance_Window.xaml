<Window x:Class="SharpRevit.UI.Views.Compliance.Fire.FireCompliance_Window"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SharpRevit.UI.Views.Compliance.Fire"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:viewModel="clr-namespace:SharpRevit.UI.ViewModels.FireCompliance"
      d:DataContext="{d:DesignInstance viewModel:FireCompliance_ViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="400" d:DesignWidth="500"
      Height="400" Width="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
      Title="FireCompliance" Background="White" Closed="Window_Closed">

    <Grid>
        <wv2:WebView2 Name="WebView" Source="http://localhost:3000/compliance" />

    </Grid>
</Window>
